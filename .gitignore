# Terraform state (contains account IDs, cluster CA data, resource ARNs)
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files (binary, contains resolved variable values)
*.tfplan
tfplan
plan.out

# Stray lock file from running `terraform init` at the repo root. The real one
# lives in terraform/.terraform.lock.hcl and stays tracked.
/.terraform.lock.hcl

# Python
__pycache__/
*.pyc

# Terraform variable files (contain operator IP, account-specific values)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform CLI output logs (contain account IDs, public IPs, CA certs)
*.log
crash.log
crash.*.log

# AWS credentials
.aws/
.aws/credentials

# OS
.DS_Store

# Grafana credentials (admin password, DevOps Agent service account token)
k8s/monitoring/grafana-admin-secret.yaml
k8s/monitoring/*-secret.yaml
!k8s/monitoring/*-secret.yaml.example

# Private key and certificate material
*.key
*.pem
*.crt

# Local Python virtualenv and test caches
.venv/
.pytest_cache/
.hypothesis/

# Local-only helper scripts
.kiro/specs/grafana-prometheus-observability/retire_req.py